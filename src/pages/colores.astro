---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import { TELAS } from '../data/colores';
import { linkWhatsApp } from '../data/sitio';

---
<Base titulo="Telas y colores" descripcion="Muestrario de telas y colores. Todos nuestros muebles se fabrican en la tela y el color que elijas.">
  <section class="mx-auto max-w-7xl px-3 pt-10 pb-16 md:px-5 md:pt-16">
    <div class="px-2">
      <h1 class="titulo">Telas <em>y colores</em></h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-humo">
        Todos los modelos se fabrican en la tela y el color que elijas. Estos son los colores con los que trabajamos hoy. Si buscás un tono especial, consultanos.
      </p>
      <p class="mt-2 text-sm text-humo">Los colores en pantalla son aproximados. Si querés, te mandamos fotos de la tela real por WhatsApp.</p>
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Telas">
        {TELAS.map((t) => <a href={`#${t.id}`} class="inline-flex min-h-11 items-center rounded-full bg-white px-5 ring-1 ring-linea hover:ring-tinta">{t.nombre}</a>)}
      </nav>
    </div>

    {TELAS.map((t) => (
      <div id={t.id} class="mt-10 scroll-mt-28 rounded-[var(--radius-tarjeta)] bg-white p-5 md:p-10">
        <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <h2 class="text-4xl font-semibold tracking-tight">{t.nombre}</h2>
          <p class="max-w-md text-humo">{t.descripcion}</p>
        </div>
        {t.fotos && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {t.fotos.map((f) => (
              <figure class="rounded-3xl bg-papel p-2.5">
                <Picture src={f.imagen} alt={f.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 700]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover" />
                <figcaption class="mt-2.5 pl-1.5 text-sm text-humo">{f.alt}</figcaption>
              </figure>
            ))}
          </div>
        )}
        <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {t.colores.map((c) => (
            <li class="reveal rounded-3xl bg-papel p-2.5">
              <div class="aspect-[4/3] w-full rounded-2xl ring-1 ring-tinta/5" style={`background:${c.hex}`}></div>
              <div class="mt-2.5 flex items-center justify-between gap-2 pl-1.5">
                <p class="font-semibold tracking-tight">{c.nombre}</p>
                <a
                  href={linkWhatsApp(`¡Hola! Quiero ver la muestra del color ${c.nombre} en ${t.nombre.toLowerCase()}.`)}
                  target="_blank"
                  rel="noopener"
                  class="grid size-11 shrink-0 place-items-center rounded-full bg-white text-wa hover:bg-wa hover:text-white"
                  aria-label={`Pedir muestra de ${c.nombre} en ${t.nombre.toLowerCase()} por WhatsApp`}
                ><Icono nombre="whatsapp" class="size-5" /></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
  <Cta titulo="¿No ves tu color?" enfasis="Tenemos más de 30" texto="Escribinos y te mandamos fotos de las telas disponibles para que elijas tranquilo." mensaje="¡Hola! Quiero ver todos los colores y telas disponibles." />
</Base>
