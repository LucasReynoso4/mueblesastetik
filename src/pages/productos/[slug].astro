---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import Icono from '../../components/Icono.astro';
import { PRODUCTOS, formatoPrecio, precioDirecto, nombreCategoria, nombreUso, type Foto, type Producto } from '../../data/productos';
import { TELAS, colorDe, telaPorId } from '../../data/colores';
import { DESCUENTO_DIRECTO, MODO_CATALOGO, SITIO, linkWhatsApp } from '../../data/sitio';

export function getStaticPaths() {
  return PRODUCTOS.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }));
}

const { producto: p } = Astro.props as { producto: Producto };
const telas = TELAS.filter((t) => !p.telas || p.telas.includes(t.id));
// Si hay una foto con máscara, va primero y se pinta del color elegido
const indiceColoreable = p.fotos.findIndex((f) => f.mascara);
const galeria = indiceColoreable > 0 ? [p.fotos[indiceColoreable], ...p.fotos.filter((_, i) => i !== indiceColoreable)] : p.fotos;
const portada = galeria[0];
const coloreable = portada.mascara
  ? {
      foto: (await getImage({ src: portada.imagen, width: 800, format: 'webp' })).src,
      mascara: (await getImage({ src: portada.mascara, width: 800, format: 'png' })).src,
    }
  : undefined;
const telaInicial = telas.find((t) => t.id === portada.tela) ?? telas[0];
const colorInicial = (portada.color && colorDe(telaInicial.id, portada.color)) || telaInicial.colores[0];
const opcionInicial = p.opciones[0];
const variasOpciones = p.opciones.length > 1;
const etiquetaOpcion = p.etiquetaOpcion ?? 'Versión';

const eleccion = (opcion: string, tela: string, color: string) =>
  `${variasOpciones ? `${opcion} · ` : ''}${tela.toLowerCase()} ${color.toLowerCase()}`;
const eleccionInicial = eleccion(opcionInicial.nombre, telaInicial.nombre, colorInicial.nombre);
const mensaje = (texto: string) => `¡Hola! Vi en su página el modelo ${p.nombre} y me interesa en ${texto}. ¿Me confirman precio y demora?`;

const etiquetaFoto = (f: Foto) => {
  const tela = f.tela ? telaPorId(f.tela) : undefined;
  const color = f.tela && f.color ? colorDe(f.tela, f.color) : undefined;
  return tela && color ? { texto: `${tela.nombre.toLowerCase()} ${color.nombre.toLowerCase()}`, hex: color.hex } : undefined;
};
const etiquetaPortada = etiquetaFoto(portada);

const relacionados = PRODUCTOS.filter((o) => o.slug !== p.slug)
  .map((o) => ({ o, puntos: (o.categoria === p.categoria ? 2 : 0) + o.usos.filter((u) => p.usos.includes(u)).length }))
  .sort((a, b) => b.puntos - a.puntos)
  .slice(0, 3)
  .map(({ o }) => o);

const og = await getImage({ src: portada.imagen, width: 600, format: 'jpg' });
const precios = p.opciones.map((o) => precioDirecto(o.precio));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nombre,
    description: p.descripcion,
    image: new URL(og.src, Astro.site).href,
    category: nombreCategoria(p.categoria),
    brand: { '@type': 'Brand', name: SITIO.nombre },
    material: telas.map((t) => t.nombre).join(', '),
    offers: MODO_CATALOGO ? undefined : {
      '@type': 'AggregateOffer',
      priceCurrency: 'ARS',
      lowPrice: Math.min(...precios),
      highPrice: Math.max(...precios),
      offerCount: p.opciones.length,
      availability: 'https://schema.org/MadeToOrder',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Catálogo', item: new URL('/catalogo', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: nombreCategoria(p.categoria), item: new URL(`/catalogo?categoria=${p.categoria}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: p.nombre },
    ],
  },
];

let paso = 0;
---
<Base titulo={p.nombre} descripcion={`${p.resumen} Fabricado a medida en más de 30 colores. Envíos a todo el país.`} imagen={og.src} jsonLd={jsonLd}>
  <nav aria-label="Ruta" class="mx-auto max-w-7xl px-5 pt-6 text-sm text-humo md:px-7">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/catalogo" class="hover:text-tinta">Catálogo</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/catalogo?categoria=${p.categoria}`} class="hover:text-tinta">{nombreCategoria(p.categoria)}</a></li>
    </ol>
  </nav>

  <article class="mx-auto grid max-w-7xl gap-3 px-3 pt-4 pb-16 md:grid-cols-2 md:px-5 md:pb-24" data-ficha data-nombre={p.nombre} data-varias-opciones={variasOpciones ? '' : undefined}>
    <div class="md:sticky md:top-24 md:self-start">
      <div class="tarjeta relative" style={`view-transition-name: foto-${p.slug}`}>
        {galeria.map((f, i) => (
          <Picture
            src={f.imagen}
            alt={`${p.nombre}${etiquetaFoto(f) ? ` en ${etiquetaFoto(f)!.texto}` : ''}`}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 600, 800]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            hidden={i !== 0}
            data-foto={i}
            data-tela={f.tela}
            data-color={f.color}
            data-etiqueta={etiquetaFoto(f)?.texto}
            data-hex={etiquetaFoto(f)?.hex}
            class="aspect-[4/5] w-full object-cover"
          />
        ))}
        {coloreable && (
          <canvas data-lienzo data-foto-src={coloreable.foto} data-mascara-src={coloreable.mascara} hidden aria-hidden="true" class="absolute inset-0 size-full object-cover"></canvas>
        )}
        <p data-etiqueta-foto hidden={!etiquetaPortada} class="etiqueta absolute bottom-4 left-4">
          <span data-etiqueta-hex class="size-3 rounded-full ring-1 ring-tinta/10" style={`background:${etiquetaPortada?.hex ?? 'transparent'}`}></span>
          <span data-etiqueta-prefijo>En la foto:</span> <span data-etiqueta-texto>{etiquetaPortada?.texto}</span>
        </p>
      </div>
      {galeria.length > 1 && (
        <div class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-7">
          {galeria.map((f, i) => (
            <button type="button" data-miniatura={i} aria-label={`Ver foto ${i + 1}${etiquetaFoto(f) ? `: ${etiquetaFoto(f)!.texto}` : ''}`} aria-current={i === 0 ? 'true' : undefined} class="miniatura">
              <Picture src={f.imagen} alt="" formats={['webp']} fallbackFormat="webp" widths={[160]} sizes="80px" class="aspect-square w-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="entrada rounded-[var(--radius-tarjeta)] bg-white p-6 md:p-10" style="--d:1">
      <span class="etiqueta !bg-papel">{nombreCategoria(p.categoria)}</span>
      <h1 class="mt-4 text-4xl leading-[1] font-semibold tracking-[-0.035em] md:text-5xl">{p.nombre}</h1>
      {MODO_CATALOGO ? null : DESCUENTO_DIRECTO > 0 ? (
        <>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-3xl font-semibold tracking-tight" data-precio>{formatoPrecio(precioDirecto(opcionInicial.precio))}</span>
            <s class="text-lg text-humo" data-precio-ml aria-label="Precio en Mercado Libre">{formatoPrecio(opcionInicial.precio)}</s>
            <span class="rounded-full bg-acento/15 px-2.5 py-0.5 text-sm font-semibold text-tinta">{Math.round(DESCUENTO_DIRECTO * 100)}% menos que en Mercado Libre</span>
          </p>
          <p class="mt-1 text-sm text-humo">Comprando directo por WhatsApp, con transferencia o efectivo. El envío se cotiza aparte. El precio tachado es el de Mercado Libre.</p>
        </>
      ) : (
        <>
          <p class="mt-4 text-3xl font-semibold tracking-tight" data-precio>{formatoPrecio(opcionInicial.precio)}</p>
          <p class="mt-1 text-sm text-humo">Precio publicado en Mercado Libre. Consultanos por pago directo y envío.</p>
        </>
      )}
      <p class="mt-4 text-lg leading-relaxed text-humo">{p.descripcion}</p>

      <ul class="mt-5 flex flex-wrap gap-2">
        {p.usos.map((u) => (
          <li><a href={`/catalogo?uso=${u}`} class="inline-flex min-h-9 items-center rounded-full bg-papel px-3.5 text-sm hover:bg-linea">{nombreUso(u)}</a></li>
        ))}
      </ul>

      <div class="mt-8 rounded-3xl bg-papel p-5 md:p-6" data-selector>
        {variasOpciones && (
          <fieldset class="mb-6">
            <legend class="font-semibold">{++paso}. Elegí {etiquetaOpcion.toLowerCase()}</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {p.opciones.map((o, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="opcion" value={o.nombre} data-precio={MODO_CATALOGO ? undefined : formatoPrecio(precioDirecto(o.precio))} data-precio-ml={MODO_CATALOGO ? undefined : formatoPrecio(o.precio)} data-ml={MODO_CATALOGO ? undefined : o.mercadolibre} checked={i === 0} class="peer sr-only" />
                  <span class="flex min-h-11 items-center gap-1.5 rounded-full bg-white px-4 text-[15px] ring-1 ring-linea transition peer-checked:bg-tinta peer-checked:text-white peer-checked:ring-tinta peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-acento">
                    {o.nombre}
                    {!MODO_CATALOGO && <span class="text-sm opacity-60">{formatoPrecio(precioDirecto(o.precio))}</span>}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <fieldset>
          <legend class="font-semibold">{++paso}. Elegí la tela</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {telas.map((t) => (
              <label class="cursor-pointer">
                <input type="radio" name="tela" value={t.id} data-nombre={t.nombre} checked={t.id === telaInicial.id} class="peer sr-only" />
                <span class="flex min-h-11 items-center rounded-full bg-white px-5 text-[15px] ring-1 ring-linea transition peer-checked:bg-tinta peer-checked:text-white peer-checked:ring-tinta peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-acento">{t.nombre}</span>
              </label>
            ))}
          </div>
          {telas.map((t) => (
            <p data-descripcion-tela={t.id} hidden={t.id !== telaInicial.id} class="mt-3 text-sm leading-relaxed text-humo">{t.descripcion}</p>
          ))}
        </fieldset>

        <fieldset class="mt-6">
          <legend class="flex w-full items-baseline justify-between gap-4 font-semibold">
            <span>{++paso}. Elegí el color</span>
            <span class="font-serif text-xl font-normal text-acento italic" data-color-nombre>{colorInicial.nombre}</span>
          </legend>
          {telas.map((t) => (
            <div data-colores-tela={t.id} hidden={t.id !== telaInicial.id} class="mt-3 flex flex-wrap gap-2">
              {t.colores.map((c) => (
                <label class="cursor-pointer" title={c.nombre}>
                  <input type="radio" name={`color-${t.id}`} value={c.nombre} data-id={c.id} data-hex={c.hex} checked={t.id === telaInicial.id ? c.id === colorInicial.id : c === t.colores[0]} class="peer sr-only" />
                  <span class="block size-12 rounded-full p-1 ring-2 ring-transparent transition peer-checked:ring-tinta peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-acento">
                    <span class="block size-full rounded-full ring-1 ring-tinta/10" style={`background:${c.hex}`}></span>
                  </span>
                  <span class="sr-only">{c.nombre}</span>
                </label>
              ))}
            </div>
          ))}
          <p class="mt-4 text-sm text-humo">
            {coloreable ? 'La foto se pinta del color que elijas (es una vista aproximada).' : 'Los colores con foto cambian la imagen.'} <a href="/colores" class="font-medium text-tinta underline underline-offset-4 hover:text-acento">Ver muestrario</a>
          </p>
        </fieldset>
      </div>

      <div class="mt-6 flex flex-col gap-2.5">
        <a data-wa-producto href={linkWhatsApp(mensaje(eleccionInicial))} target="_blank" rel="noopener" class="btn-wa w-full !min-h-14 !text-base">
          <Icono nombre="whatsapp" class="size-5" /> Consultar por WhatsApp
        </a>
        <div class:list={['grid gap-2.5', !MODO_CATALOGO && 'grid-cols-2']}>
          <button type="button" data-agregar data-slug={p.slug} data-nombre={p.nombre} data-color={eleccionInicial} class="btn-claro">
            <Icono nombre="mas" class="size-4" /> A mi lista
          </button>
          {!MODO_CATALOGO && (
            <a data-ml-producto href={opcionInicial.mercadolibre} target="_blank" rel="noopener" class="btn-ml">
              Mercado Libre
            </a>
          )}
        </div>
      </div>

      <div class="mt-8 border-t border-linea pt-6">
        <h2 class="font-semibold">Detalles</h2>
        <ul class="mt-3 space-y-2.5">
          {p.detalles.map((d) => (
            <li class="flex gap-3 text-humo"><Icono nombre="check" class="mt-0.5 size-5 shrink-0 text-acento" /> {d}</li>
          ))}
        </ul>
      </div>

      <ul class="mt-8 grid grid-cols-3 gap-2 text-center text-sm">
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="regla" class="mx-auto size-6 text-acento" /><p class="mt-2">A medida</p></li>
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="camion" class="mx-auto size-6 text-acento" /><p class="mt-2">Envíos al país</p></li>
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="estrella" class="mx-auto size-6 text-acento" /><p class="mt-2">Fabricación propia</p></li>
      </ul>
    </div>
  </article>

  <section class="mx-auto max-w-7xl px-3 pb-12 md:px-5">
    <div class="rounded-[var(--radius-tarjeta)] bg-nube px-4 py-14 md:px-10">
      <h2 class="titulo px-1 !text-4xl md:!text-5xl">También te puede <em>gustar</em></h2>
      <div class="escalonado mt-8 grid grid-cols-2 gap-x-3 gap-y-8 md:gap-x-5 lg:grid-cols-3">
        {relacionados.map((o) => <ProductoCard producto={o} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  @reference '../../styles/global.css';
  .miniatura {
    @apply cursor-pointer overflow-hidden rounded-2xl opacity-70 ring-2 ring-transparent transition hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acento;
  }
  .miniatura[aria-current='true'] {
    @apply opacity-100 ring-tinta;
  }
</style>

<script>
  import { prepararColoreo, type Colorear } from '../../scripts/colorear';

  const ficha = document.querySelector<HTMLElement>('[data-ficha]')!;
  const selector = ficha.querySelector<HTMLElement>('[data-selector]')!;
  const nombre = ficha.dataset.nombre!;
  const variasOpciones = ficha.hasAttribute('data-varias-opciones');
  const wa = ficha.querySelector<HTMLAnchorElement>('[data-wa-producto]')!;
  const ml = ficha.querySelector<HTMLAnchorElement>('[data-ml-producto]');
  const agregar = ficha.querySelector<HTMLButtonElement>('[data-agregar]')!;
  const etiqueta = ficha.querySelector<HTMLElement>('[data-color-nombre]')!;
  const precio = ficha.querySelector<HTMLElement>('[data-precio]');
  const precioMl = ficha.querySelector<HTMLElement>('[data-precio-ml]');
  const fotos = [...ficha.querySelectorAll<HTMLImageElement>('img[data-foto]')];
  const miniaturas = [...ficha.querySelectorAll<HTMLButtonElement>('[data-miniatura]')];
  const etiquetaFoto = ficha.querySelector<HTMLElement>('[data-etiqueta-foto]')!;
  const lienzo = ficha.querySelector<HTMLCanvasElement>('canvas[data-lienzo]');

  // Foto que se pinta del color elegido (la primera, si tiene máscara)
  let colorear: Promise<Colorear> | undefined;
  /** Color con el que está pintada la foto, o undefined si se ve la original */
  let pintada: { texto: string; hex: string } | undefined;

  function mostrarEtiqueta(prefijo: string, texto: string | undefined, hex: string | undefined) {
    etiquetaFoto.hidden = !texto;
    etiquetaFoto.querySelector<HTMLElement>('[data-etiqueta-prefijo]')!.textContent = prefijo;
    etiquetaFoto.querySelector<HTMLElement>('[data-etiqueta-texto]')!.textContent = texto ?? '';
    etiquetaFoto.querySelector<HTMLElement>('[data-etiqueta-hex]')!.style.background = hex ?? 'transparent';
  }

  function mostrarFoto(indice: number) {
    const conColor = indice === 0 && !!lienzo && !!pintada;
    fotos.forEach((f, i) => (f.hidden = i !== indice));
    if (lienzo) lienzo.hidden = !conColor;
    miniaturas.forEach((m, i) => (i === indice ? m.setAttribute('aria-current', 'true') : m.removeAttribute('aria-current')));
    if (conColor) mostrarEtiqueta('Vista aproximada:', pintada!.texto, pintada!.hex);
    else mostrarEtiqueta('En la foto:', fotos[indice].dataset.etiqueta, fotos[indice].dataset.hex);
  }

  async function pintar(tela: HTMLInputElement, color: HTMLInputElement) {
    const base = fotos[0].dataset;
    if (base.tela === tela.value && base.color === color.dataset.id) {
      pintada = undefined;
    } else {
      colorear ??= prepararColoreo(lienzo!, lienzo!.dataset.fotoSrc!, lienzo!.dataset.mascaraSrc!, fotos[0].dataset.hex!);
      const aplicar = await colorear;
      // Si mientras cargaba se eligió otro color, ese manda
      if (selector.querySelector(`input[name="color-${tela.value}"]:checked`) !== color || !tela.checked) return;
      aplicar(color.dataset.hex!);
      pintada = { texto: `${tela.dataset.nombre!.toLowerCase()} ${color.value.toLowerCase()}`, hex: color.dataset.hex! };
    }
    mostrarFoto(0);
  }

  miniaturas.forEach((m, i) => m.addEventListener('click', () => mostrarFoto(i)));

  function actualizar(evento: Event) {
    const tela = selector.querySelector<HTMLInputElement>('input[name="tela"]:checked')!;
    selector.querySelectorAll<HTMLElement>('[data-colores-tela]').forEach((g) => (g.hidden = g.dataset.coloresTela !== tela.value));
    selector.querySelectorAll<HTMLElement>('[data-descripcion-tela]').forEach((d) => (d.hidden = d.dataset.descripcionTela !== tela.value));
    const color = selector.querySelector<HTMLInputElement>(`input[name="color-${tela.value}"]:checked`)!;
    const opcion = selector.querySelector<HTMLInputElement>('input[name="opcion"]:checked');

    if (opcion) {
      if (precio) precio.textContent = opcion.dataset.precio!;
      if (precioMl) precioMl.textContent = opcion.dataset.precioMl!;
      if (ml) ml.href = opcion.dataset.ml!;
    }

    if ((evento.target as HTMLInputElement).name !== 'opcion' && lienzo) {
      pintar(tela, color).catch(() => {});
    } else if ((evento.target as HTMLInputElement).name !== 'opcion') {
      const indice = fotos.findIndex((f) => f.dataset.tela === tela.value && f.dataset.color === color.dataset.id);
      if (indice >= 0) mostrarFoto(indice);
    }

    const texto = `${variasOpciones && opcion ? `${opcion.value} · ` : ''}${tela.dataset.nombre!.toLowerCase()} ${color.value.toLowerCase()}`;
    etiqueta.textContent = color.value;
    agregar.dataset.color = texto;
    const url = new URL(wa.href);
    url.searchParams.set('text', `¡Hola! Vi en su página el modelo ${nombre} y me interesa en ${texto}. ¿Me confirman precio y demora?`);
    wa.href = url.href;
  }

  selector.addEventListener('change', actualizar);
  // Dejar la foto lista para pintar apenas cargue la página, así el primer cambio es instantáneo
  if (lienzo) {
    const preparar = () => (colorear ??= prepararColoreo(lienzo, lienzo.dataset.fotoSrc!, lienzo.dataset.mascaraSrc!, fotos[0].dataset.hex!));
    'requestIdleCallback' in window ? requestIdleCallback(preparar) : setTimeout(preparar, 300);
  }
</script>
