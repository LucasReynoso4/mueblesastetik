---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import Icono from '../../components/Icono.astro';
import { PRODUCTOS, nombreCategoria, nombreUso, type Producto } from '../../data/productos';
import { TELAS, colorDe, telaPorId } from '../../data/colores';
import { SITIO, linkWhatsApp } from '../../data/sitio';

export function getStaticPaths() {
  return PRODUCTOS.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }));
}

const { producto: p } = Astro.props as { producto: Producto };
const telas = TELAS.filter((t) => !p.telas || p.telas.includes(t.id));
const telaInicial = telaPorId(p.foto.tela) ?? telas[0];
const colorInicial = colorDe(p.foto.tela, p.foto.color) ?? telaInicial.colores[0];
const eleccion = (tela: string, color: string) => `${tela.toLowerCase()} ${color.toLowerCase()}`;
const eleccionInicial = eleccion(telaInicial.nombre, colorInicial.nombre);
const mensaje = (texto: string) => `¡Hola! Vi en su página el modelo ${p.nombre} y me interesa en ${texto}. ¿Me pasan precio y demora?`;

const relacionados = PRODUCTOS.filter((o) => o.slug !== p.slug)
  .map((o) => ({ o, puntos: (o.categoria === p.categoria ? 2 : 0) + o.usos.filter((u) => p.usos.includes(u)).length }))
  .sort((a, b) => b.puntos - a.puntos)
  .slice(0, 3)
  .map(({ o }) => o);

const og = await getImage({ src: p.imagenes[0], width: 600, format: 'jpg' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nombre,
    description: p.descripcion,
    image: new URL(og.src, Astro.site).href,
    category: nombreCategoria(p.categoria),
    brand: { '@type': 'Brand', name: SITIO.nombre },
    material: telas.map((t) => t.nombre).join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Catálogo', item: new URL('/catalogo', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: nombreCategoria(p.categoria), item: new URL(`/catalogo?categoria=${p.categoria}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: p.nombre },
    ],
  },
];
---
<Base titulo={p.nombre} descripcion={`${p.resumen} Fabricado a medida en más de 30 colores. Envíos a todo el país.`} imagen={og.src} jsonLd={jsonLd}>
  <nav aria-label="Ruta" class="mx-auto max-w-7xl px-5 pt-6 text-sm text-humo md:px-7">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/catalogo" class="hover:text-tinta">Catálogo</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/catalogo?categoria=${p.categoria}`} class="hover:text-tinta">{nombreCategoria(p.categoria)}</a></li>
    </ol>
  </nav>

  <article class="mx-auto grid max-w-7xl gap-3 px-3 pt-4 pb-16 md:grid-cols-2 md:px-5 md:pb-24" data-ficha data-nombre={p.nombre}>
    <div class="md:sticky md:top-24 md:self-start">
      <div class="tarjeta relative" style={`view-transition-name: foto-${p.slug}`}>
        <Picture
          src={p.imagenes[0]}
          alt={`${p.nombre} en ${eleccionInicial}`}
          formats={['avif', 'webp']}
          widths={[480, 600]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
        />
        <p class="etiqueta absolute bottom-4 left-4">
          <span class="size-3 rounded-full ring-1 ring-tinta/10" style={`background:${colorInicial.hex}`}></span>
          En la foto: {telaInicial.nombre.toLowerCase()} {colorInicial.nombre.toLowerCase()}
        </p>
      </div>
      {p.imagenes.length > 1 && (
        <div class="mt-3 grid grid-cols-4 gap-3">
          {p.imagenes.slice(1).map((img) => (
            <Picture src={img} alt={p.nombre} formats={['webp']} widths={[240]} sizes="25vw" class="aspect-square w-full rounded-2xl object-cover" />
          ))}
        </div>
      )}
    </div>

    <div class="entrada rounded-[var(--radius-tarjeta)] bg-white p-6 md:p-10" style="--d:1">
      <span class="etiqueta !bg-papel">{nombreCategoria(p.categoria)}</span>
      <h1 class="mt-4 text-4xl leading-[1] font-semibold tracking-[-0.035em] md:text-5xl">{p.nombre}</h1>
      <p class="mt-4 text-lg leading-relaxed text-humo">{p.descripcion}</p>

      <ul class="mt-5 flex flex-wrap gap-2">
        {p.usos.map((u) => (
          <li><a href={`/catalogo?uso=${u}`} class="inline-flex min-h-9 items-center rounded-full bg-papel px-3.5 text-sm hover:bg-linea">{nombreUso(u)}</a></li>
        ))}
      </ul>

      <div class="mt-8 rounded-3xl bg-papel p-5 md:p-6" data-selector>
        <fieldset>
          <legend class="font-semibold">1. Elegí la tela</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {telas.map((t) => (
              <label class="cursor-pointer">
                <input type="radio" name="tela" value={t.id} data-nombre={t.nombre} checked={t.id === telaInicial.id} class="peer sr-only" />
                <span class="flex min-h-11 items-center rounded-full bg-white px-5 text-[15px] ring-1 ring-linea transition peer-checked:bg-tinta peer-checked:text-white peer-checked:ring-tinta peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-acento">{t.nombre}</span>
              </label>
            ))}
          </div>
          {telas.map((t) => (
            <p data-descripcion-tela={t.id} hidden={t.id !== telaInicial.id} class="mt-3 text-sm leading-relaxed text-humo">{t.descripcion}</p>
          ))}
        </fieldset>

        <fieldset class="mt-6">
          <legend class="flex w-full items-baseline justify-between gap-4 font-semibold">
            <span>2. Elegí el color</span>
            <span class="font-serif text-xl font-normal text-acento italic" data-color-nombre>{colorInicial.nombre}</span>
          </legend>
          {telas.map((t) => (
            <div data-colores-tela={t.id} hidden={t.id !== telaInicial.id} class="mt-3 flex flex-wrap gap-2">
              {t.colores.map((c) => (
                <label class="cursor-pointer" title={c.nombre}>
                  <input type="radio" name={`color-${t.id}`} value={c.nombre} checked={t.id === telaInicial.id ? c.id === colorInicial.id : c === t.colores[0]} class="peer sr-only" />
                  <span class="block size-12 rounded-full p-1 ring-2 ring-transparent transition peer-checked:ring-tinta peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-acento">
                    <span class="block size-full rounded-full ring-1 ring-tinta/10" style={`background:${c.hex}`}></span>
                  </span>
                  <span class="sr-only">{c.nombre}</span>
                </label>
              ))}
            </div>
          ))}
          <p class="mt-4 text-sm text-humo">
            ¿Buscás otro tono? Tenemos más de 30. <a href="/colores" class="font-medium text-tinta underline underline-offset-4 hover:text-acento">Ver todos</a>
          </p>
        </fieldset>
      </div>

      <div class="mt-6 flex flex-col gap-2.5">
        <a data-wa-producto href={linkWhatsApp(mensaje(eleccionInicial))} target="_blank" rel="noopener" class="btn-wa w-full !min-h-14 !text-base">
          <Icono nombre="whatsapp" class="size-5" /> Consultar precio por WhatsApp
        </a>
        <div class="grid grid-cols-2 gap-2.5">
          <button type="button" data-agregar data-slug={p.slug} data-nombre={p.nombre} data-color={eleccionInicial} class="btn-claro">
            <Icono nombre="mas" class="size-4" /> A mi lista
          </button>
          <a href={p.mercadolibre ?? SITIO.mercadolibre} target="_blank" rel="noopener" class="btn-ml">
            {p.mercadolibre ? 'Mercado Libre' : 'Ver en ML'}
          </a>
        </div>
      </div>

      <div class="mt-8 border-t border-linea pt-6">
        <h2 class="font-semibold">Detalles</h2>
        <ul class="mt-3 space-y-2.5">
          {p.detalles.map((d) => (
            <li class="flex gap-3 text-humo"><Icono nombre="check" class="mt-0.5 size-5 shrink-0 text-acento" /> {d}</li>
          ))}
        </ul>
      </div>

      <ul class="mt-8 grid grid-cols-3 gap-2 text-center text-sm">
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="regla" class="mx-auto size-6 text-acento" /><p class="mt-2">A medida</p></li>
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="camion" class="mx-auto size-6 text-acento" /><p class="mt-2">Envíos al país</p></li>
        <li class="rounded-2xl bg-papel px-2 py-4"><Icono nombre="estrella" class="mx-auto size-6 text-acento" /><p class="mt-2">Fabricación propia</p></li>
      </ul>
    </div>
  </article>

  <section class="mx-auto max-w-7xl px-3 pb-12 md:px-5">
    <div class="rounded-[var(--radius-tarjeta)] bg-nube px-4 py-14 md:px-10">
      <h2 class="titulo px-1 !text-4xl md:!text-5xl">También te puede <em>gustar</em></h2>
      <div class="escalonado mt-8 grid grid-cols-2 gap-x-3 gap-y-8 md:gap-x-5 lg:grid-cols-3">
        {relacionados.map((o) => <ProductoCard producto={o} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  const ficha = document.querySelector<HTMLElement>('[data-ficha]')!;
  const selector = ficha.querySelector<HTMLElement>('[data-selector]')!;
  const nombre = ficha.dataset.nombre!;
  const wa = ficha.querySelector<HTMLAnchorElement>('[data-wa-producto]')!;
  const agregar = ficha.querySelector<HTMLButtonElement>('[data-agregar]')!;
  const etiqueta = ficha.querySelector<HTMLElement>('[data-color-nombre]')!;

  function actualizar() {
    const tela = selector.querySelector<HTMLInputElement>('input[name="tela"]:checked')!;
    selector.querySelectorAll<HTMLElement>('[data-colores-tela]').forEach((g) => (g.hidden = g.dataset.coloresTela !== tela.value));
    selector.querySelectorAll<HTMLElement>('[data-descripcion-tela]').forEach((d) => (d.hidden = d.dataset.descripcionTela !== tela.value));
    const color = selector.querySelector<HTMLInputElement>(`input[name="color-${tela.value}"]:checked`)!;

    const texto = `${tela.dataset.nombre!.toLowerCase()} ${color.value.toLowerCase()}`;
    etiqueta.textContent = color.value;
    agregar.dataset.color = texto;
    const url = new URL(wa.href);
    url.searchParams.set('text', `¡Hola! Vi en su página el modelo ${nombre} y me interesa en ${texto}. ¿Me pasan precio y demora?`);
    wa.href = url.href;
  }

  selector.addEventListener('change', actualizar);
</script>
