---
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard.astro';
import Cta from '../components/Cta.astro';
import { PRODUCTOS, CATEGORIAS, USOS } from '../data/productos';
import { linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';

const listado = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: PRODUCTOS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/productos/${p.slug}`, Astro.site).href,
    name: p.nombre,
  })),
};
---
<Base
  titulo="Catálogo"
  descripcion="Catálogo de sillones, puffs, mostradores, respaldos y camillas capitoné. Todos los modelos se fabrican a medida en más de 30 colores."
  jsonLd={[listado]}
>
  <section class="mx-auto max-w-7xl px-3 pt-10 pb-20 md:px-5 md:pt-16">
    <div class="px-2">
      <h1 class="titulo">Nuestros <em>modelos</em></h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-humo">
        Cada modelo se fabrica a medida, en la tela y el color que elijas. Las fotos muestran un ejemplo: <a href="/colores" class="font-medium text-tinta underline decoration-oro decoration-2 underline-offset-4 hover:text-acento">mirá todas las telas y colores</a>.
      </p>
    </div>

    <div id="filtros" class="sticky top-[4.75rem] z-30 -mx-3 mt-8 border-b border-linea bg-papel px-3 py-2 md:top-[4.75rem] md:mx-0 md:rounded-[var(--radius-tarjeta)] md:border-0 md:bg-white/90 md:p-2 md:ring-1 md:ring-linea/70 md:backdrop-blur-xl">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div class="carrusel !gap-1.5" role="group" aria-label="Filtrar por categoría">
          <button type="button" data-filtro="categoria" data-valor="" class="chip" aria-pressed="true">Todos</button>
          {CATEGORIAS.map((c) => (
            <button type="button" data-filtro="categoria" data-valor={c.id} class="chip" aria-pressed="false">{c.nombre}</button>
          ))}
        </div>
        <label class="flex items-center gap-2 px-2 text-sm text-humo md:px-0">
          <span class="shrink-0">Para</span>
          <select data-filtro-uso class="min-h-10 w-full md:min-h-11 rounded-full bg-white ring-1 ring-linea md:bg-papel md:ring-0 px-4 text-[15px] text-tinta md:w-auto">
            <option value="">Cualquier uso</option>
            {USOS.map((u) => <option value={u.id}>{u.nombre}</option>)}
          </select>
        </label>
      </div>
    </div>

    <p data-resultado class="mt-6 px-2 text-sm text-humo" aria-live="polite">{PRODUCTOS.length} modelos</p>

    <div class="escalonado mt-4 grid grid-cols-2 gap-x-3 gap-y-8 md:gap-x-5 lg:grid-cols-3">
      {PRODUCTOS.map((p, i) => <ProductoCard producto={p} prioridad={i < 4} />)}
    </div>
    <p data-sin-resultados hidden class="py-16 text-center text-humo">
      No hay modelos con esos filtros. Igual consultanos: <a class="font-medium text-tinta underline" href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener">fabricamos a pedido</a>.
    </p>
  </section>
  <Cta titulo="¿No encontraste lo que buscás?" enfasis="Lo fabricamos a pedido" />
</Base>

<style>
  @reference '../styles/global.css';
  .chip {
    @apply min-h-11 cursor-pointer rounded-full px-4 text-[15px] whitespace-nowrap text-humo transition hover:bg-papel hover:text-tinta;
  }
  .chip[aria-pressed='true'] {
    @apply bg-tinta text-white;
  }
</style>

<script>
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-producto]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro="categoria"]')];
  const selectUso = document.querySelector<HTMLSelectElement>('[data-filtro-uso]')!;
  const resultado = document.querySelector<HTMLElement>('[data-resultado]')!;
  const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]')!;

  function aplicar(categoria: string, uso: string, actualizarUrl = true) {
    let visibles = 0;
    for (const t of tarjetas) {
      const ok = (!categoria || t.dataset.categoria === categoria) && (!uso || t.dataset.usos!.split(' ').includes(uso));
      t.hidden = !ok;
      if (ok) visibles++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.valor === categoria)));
    selectUso.value = uso;
    resultado.textContent = `${visibles} ${visibles === 1 ? 'modelo' : 'modelos'}`;
    sinResultados.hidden = visibles > 0;

    if (actualizarUrl) {
      const url = new URL(location.href);
      categoria ? url.searchParams.set('categoria', categoria) : url.searchParams.delete('categoria');
      uso ? url.searchParams.set('uso', uso) : url.searchParams.delete('uso');
      history.replaceState(null, '', url);
    }
  }

  const params = new URLSearchParams(location.search);
  let categoria = params.get('categoria') ?? '';
  let uso = params.get('uso') ?? '';
  aplicar(categoria, uso, false);

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      categoria = c.dataset.valor ?? '';
      aplicar(categoria, uso);
    }),
  );
  selectUso.addEventListener('change', () => {
    uso = selectUso.value;
    aplicar(categoria, uso);
  });
</script>
