---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <p class="antetitulo justify-center">Error 404</p>
    <h1 class="titulo mt-5">Esta página <em>no existe</em></h1>
    <p class="mt-6 text-tinta/60">Puede que el producto ya no esté o que el link tenga un error.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/catalogo" class="btn-oro">Ver catálogo</a>
      <a href="/" class="btn-borde">Ir al inicio</a>
    </div>
  </section>
</Base>
