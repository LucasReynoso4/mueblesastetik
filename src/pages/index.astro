---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import hero from '../assets/hero.jpg';
import { PRODUCTOS, CATEGORIAS } from '../data/productos';
import { TELAS } from '../data/colores';
import { SITIO, CIFRAS, linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';

const destacados = PRODUCTOS.filter((p) => p.destacado).slice(0, 6);
const categorias = CATEGORIAS.map((c) => {
  const productos = PRODUCTOS.filter((p) => p.categoria === c.id);
  return { ...c, cantidad: productos.length, imagen: productos[0]?.imagenes[0] };
}).filter((c) => c.cantidad > 0);

const BENEFICIOS = [
  { icono: 'regla', titulo: 'A medida', texto: 'Adaptamos medidas, tela y color a tu espacio.' },
  { icono: 'estrella', titulo: 'Fabricación propia', texto: 'Hacemos cada mueble en nuestro taller.' },
  { icono: 'camion', titulo: 'Envíos al país', texto: 'Llegamos a todo el país, bien embalado.' },
  { icono: 'escudo', titulo: 'Compra segura', texto: 'Más de 1000 ventas en Mercado Libre nos respaldan.' },
] as const;
---
<Base headerSobreFoto>
  <!-- PORTADA -->
  <section class="relative flex min-h-[100svh] items-end overflow-hidden bg-noche text-white md:items-center">
    <Picture
      src={hero}
      alt="Sillones de relax capitoné en un spa"
      formats={['avif', 'webp']}
      widths={[640, 1024]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover object-[center_30%] opacity-80"
    />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_10%,rgba(5,4,2,0.6)_100%),linear-gradient(to_bottom,rgba(5,4,2,0.55),rgba(5,4,2,0.2)_40%,rgba(5,4,2,0.85))]"></div>

    <div class="relative mx-auto w-full max-w-7xl px-5 pt-32 pb-16 md:px-8 md:pb-0">
      <p class="antetitulo text-oro-claro before:bg-oro-claro">Muebles tapizados a medida</p>
      <h1 class="mt-6 max-w-3xl font-serif text-5xl leading-[1.02] tracking-tight text-balance md:text-7xl lg:text-8xl">
        Muebles que <em class="text-[#f5e4b8]">transforman</em> tu espacio
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
        Sillones, puffs, mostradores y respaldos capitoné. Elegís el modelo, el color y la medida: nosotros lo fabricamos.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/catalogo" class="btn bg-white text-tinta hover:bg-crema">
          Ver catálogo <Icono nombre="flecha" class="size-4" />
        </a>
        <a href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener" class="btn-wa">
          <Icono nombre="whatsapp" class="size-5" /> Pedir presupuesto
        </a>
      </div>
    </div>
  </section>

  <!-- CIFRAS -->
  <section class="border-b border-linea bg-marfil">
    <dl class="mx-auto grid max-w-7xl grid-cols-2 md:grid-cols-4">
      {CIFRAS.map((c, i) => (
        <div class:list={['flex flex-col-reverse px-5 py-8 text-center md:py-10', i % 2 === 0 && 'border-r border-linea', i === 1 && 'md:border-r', i < 2 && 'border-b border-linea md:border-b-0']}>
          <dt class="mt-1 text-[11px] uppercase tracking-[0.2em] text-tinta/55">{c.etiqueta}</dt>
          <dd class="font-serif text-4xl text-oro md:text-5xl">{c.valor}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- CATEGORÍAS -->
  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="antetitulo">Qué hacemos</p>
        <h2 class="titulo mt-4">Elegí por <em>categoría</em></h2>
      </div>
      <a href="/catalogo" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-tinta/70 hover:text-tinta">
        Ver todo el catálogo <Icono nombre="flecha" class="size-4" />
      </a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-4">
      {categorias.map((c, i) => (
        <li class:list={['reveal group relative overflow-hidden bg-linea', i === 0 && 'col-span-2 md:col-span-1']}>
          {c.imagen && (
            <Image src={c.imagen} alt="" widths={[300, 600]} sizes="(min-width: 768px) 20vw, 50vw" class:list={['size-full object-cover transition-transform duration-[1.2s] ease-suave group-hover:scale-105', i === 0 ? 'aspect-[16/10] md:aspect-[3/4]' : 'aspect-[3/4]']} />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-noche/80 via-noche/10 to-transparent"></div>
          <a href={`/catalogo?categoria=${c.id}`} class="absolute inset-x-0 bottom-0 p-4 text-white after:absolute after:inset-0 md:p-5">
            <span class="block font-serif text-2xl">{c.nombre}</span>
            <span class="text-[10px] uppercase tracking-[0.2em] text-white/70">{c.cantidad} {c.cantidad === 1 ? 'modelo' : 'modelos'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- DESTACADOS -->
  <section class="bg-marfil">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <div class="reveal max-w-2xl">
        <p class="antetitulo">Los más pedidos</p>
        <h2 class="titulo mt-4">Cada pieza, <em>hecha a mano</em></h2>
      </div>
      <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((p) => <div class="reveal"><ProductoCard producto={p} /></div>)}
      </div>
      <div class="mt-14 text-center">
        <a href="/catalogo" class="btn-borde">Ver los {PRODUCTOS.length} modelos <Icono nombre="flecha" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- COLORES -->
  <section class="bg-noche text-crema">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 md:grid-cols-2 md:gap-20 md:px-8 md:py-28">
      <div class="reveal">
        <p class="antetitulo">Personalización</p>
        <h2 class="titulo mt-4">Cualquier modelo, <em>en la tela y el color que quieras</em></h2>
        <p class="mt-6 max-w-md leading-relaxed text-crema/60">
          Elegí el modelo, la tela y el color: trabajamos con más de 30 combinaciones y lo fabricamos para vos.
        </p>
        <a href="/colores" class="btn-oro mt-10">Ver muestrario <Icono nombre="flecha" class="size-4" /></a>
      </div>
      <div class="reveal space-y-8">
        {TELAS.map((t) => (
          <div>
            <p class="mb-4 text-[11px] uppercase tracking-[0.25em] text-oro-claro">{t.nombre}</p>
            <ul class="flex flex-wrap gap-3" aria-label={`Colores en ${t.nombre.toLowerCase()}`}>
              {t.colores.map((c) => (
                <li title={c.nombre} class="size-11 rounded-full border border-white/15 shadow-inner md:size-12" style={`background:${c.hex}`}><span class="sr-only">{c.nombre}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SALONES -->
  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="reveal grid items-center gap-10 overflow-hidden border border-linea bg-gradient-to-br from-marfil to-[#f3efe5] md:grid-cols-2">
      <Image src={PRODUCTOS.find((p) => p.slug === 'mostrador-capitone')!.imagenes[0]} alt="Recepción con mostrador capitoné negro" widths={[480, 600]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] size-full object-cover md:aspect-auto md:h-full" />
      <div class="px-6 pb-10 md:py-14 md:pr-14 md:pl-0">
        <p class="antetitulo">Para profesionales</p>
        <h2 class="titulo mt-4 !text-4xl md:!text-5xl">Equipá tu salón <em>con identidad</em></h2>
        <p class="mt-5 leading-relaxed text-tinta/65">
          Mostradores, camillas, puffs y sillones de espera para centros de estética, peluquerías, uñas, pestañas y locales. Todo en el color de tu marca.
        </p>
        <a href="/estetica" class="btn-oro mt-8">Ver equipamiento <Icono nombre="flecha" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="border-t border-linea bg-marfil">
    <ul class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:grid-cols-2 md:px-8 lg:grid-cols-4">
      {BENEFICIOS.map((b) => (
        <li class="reveal flex gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-full border border-oro/40 text-oro"><Icono nombre={b.icono} class="size-5" /></span>
          <div>
            <p class="font-serif text-lg">{b.titulo}</p>
            <p class="mt-1 text-sm leading-relaxed text-tinta/60">{b.texto}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 border-t border-linea px-5 py-10 md:flex-row md:items-center md:px-8">
      <p class="font-serif text-xl md:text-2xl">¿Preferís comprar por Mercado Libre? <em class="text-tinta/50">También estamos ahí.</em></p>
      <a href={SITIO.mercadolibre} target="_blank" rel="noopener" class="btn-ml">Ver tienda en Mercado Libre</a>
    </div>
  </section>

  <Cta />
</Base>
