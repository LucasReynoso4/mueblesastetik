---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import hero from '../assets/hero.jpg';
import { PRODUCTOS, CATEGORIAS, productoPorSlug } from '../data/productos';
import { TELAS } from '../data/colores';
import { SITIO, CIFRAS, linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';

const destacados = PRODUCTOS.filter((p) => p.destacado).slice(0, 6);
const categorias = CATEGORIAS.map((c) => {
  const productos = PRODUCTOS.filter((p) => p.categoria === c.id);
  return { ...c, cantidad: productos.length, imagen: productos[0]?.imagenes[0] };
}).filter((c) => c.cantidad > 0);

const mosaico = ['sillon-labios', 'puff-redondo-capitone'].map((s) => productoPorSlug(s)!);
const mostrador = productoPorSlug('mostrador-capitone')!;
const camilla = productoPorSlug('camilla-capitone')!;

const DESFILE = ['Hecho a medida', 'Más de 30 colores', 'Envíos a todo el país', 'Fabricación propia', 'Terciopelo y eco-cuero', 'Equipamiento para salones'];
---
<Base>
  <!-- PORTADA -->
  <section class="mx-auto max-w-7xl px-3 pt-6 md:px-5 md:pt-10">
    <div class="grid gap-3 lg:grid-cols-[1.1fr_1fr]">
      <div class="flex flex-col justify-between rounded-[var(--radius-tarjeta)] bg-white p-6 md:p-10 lg:p-12">
        <div>
          <span class="etiqueta !bg-papel"><span class="size-2 rounded-full bg-wa"></span> Más de 1000 ventas en Mercado Libre</span>
          <h1 class="mt-6 text-[3rem] leading-[0.92] font-semibold tracking-[-0.045em] text-balance sm:text-7xl lg:text-[5.5rem]">
            Muebles que <em class="font-serif font-normal tracking-[-0.01em] text-acento italic">enamoran</em>, hechos a tu medida
          </h1>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-humo">
            Sillones, puffs, mostradores, respaldos y camillas capitoné. Elegís el modelo, la tela y el color: nosotros lo fabricamos.
          </p>
        </div>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/catalogo" class="btn-primario">Ver catálogo <Icono nombre="flecha" class="size-4" /></a>
          <a href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener" class="btn-claro">
            <Icono nombre="whatsapp" class="size-5 text-wa" /> Pedir presupuesto
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <a href="/estetica" class="group tarjeta relative col-span-2 aspect-[16/10] bg-tinta">
          <Picture src={hero} alt="Sillones de relax capitoné en un spa" formats={['avif', 'webp']} widths={[640, 1024]} sizes="(min-width: 1024px) 45vw, 100vw" loading="eager" fetchpriority="high" class="size-full object-cover opacity-90 transition-transform duration-700 ease-suave group-hover:scale-[1.03]" />
          <span class="etiqueta absolute bottom-4 left-4">Para tu salón <Icono nombre="flecha" class="size-4" /></span>
        </a>
        {mosaico.map((p) => (
          <a href={`/productos/${p.slug}`} class="group tarjeta relative aspect-square">
            <Picture src={p.imagenes[0]} alt={p.nombre} formats={['avif', 'webp']} widths={[320, 480]} sizes="(min-width: 1024px) 22vw, 50vw" loading="eager" class="size-full object-cover transition-transform duration-700 ease-suave group-hover:scale-[1.04]" />
            <span class="etiqueta absolute bottom-3 left-3 !text-xs">{p.nombre}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DESFILE DE BENEFICIOS -->
  <div class="mt-3 overflow-hidden border-y border-linea bg-nube py-4" aria-label="Beneficios">
    <ul class="flex w-max animate-[desfile_40s_linear_infinite] gap-10 text-lg font-medium tracking-tight motion-reduce:animate-none">
      {[...DESFILE, ...DESFILE].map((d, i) => (
        <li class="flex items-center gap-10" aria-hidden={i >= DESFILE.length ? 'true' : undefined}>{d}<span class="text-oro" aria-hidden="true">✦</span></li>
      ))}
    </ul>
  </div>

  <!-- CATEGORÍAS -->
  <section class="mx-auto max-w-7xl px-3 py-20 md:px-5 md:py-28">
    <div class="reveal flex items-end justify-between gap-6 px-2">
      <h2 class="titulo">Elegí por <em>categoría</em></h2>
      <a href="/catalogo" class="hidden items-center gap-2 font-medium hover:text-acento md:inline-flex">Ver todo <Icono nombre="flecha" class="size-4" /></a>
    </div>
    <ul class="carrusel mt-10 -mx-3 px-3 md:mx-0 md:grid md:grid-cols-5 md:px-0">
      {categorias.map((c) => (
        <li class="group relative w-[44vw] sm:w-60 md:w-auto">
          <div class="tarjeta aspect-[3/4]">
            {c.imagen && <Image src={c.imagen} alt="" widths={[300, 500]} sizes="(min-width: 768px) 20vw, 45vw" class="size-full object-cover transition-transform duration-700 ease-suave group-hover:scale-[1.05]" />}
          </div>
          <a href={`/catalogo?categoria=${c.id}`} class="mt-3 flex items-center justify-between px-1 after:absolute after:inset-0">
            <span class="text-lg font-semibold tracking-tight">{c.nombre}</span>
            <span class="text-sm text-humo">{c.cantidad}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- DESTACADOS -->
  <section class="mx-auto max-w-7xl px-3 md:px-5">
    <div class="rounded-[var(--radius-tarjeta)] bg-nube px-4 py-14 md:px-10 md:py-20">
      <div class="reveal flex flex-col justify-between gap-4 px-1 md:flex-row md:items-end">
        <h2 class="titulo">Los más <em>pedidos</em></h2>
        <p class="max-w-sm text-humo">Cada modelo se hace en la tela y el color que quieras. Las fotos son solo un ejemplo.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-3 gap-y-8 md:gap-x-5 lg:grid-cols-3">
        {destacados.map((p) => <div class="reveal"><ProductoCard producto={p} /></div>)}
      </div>
      <div class="mt-12 text-center">
        <a href="/catalogo" class="btn-primario">Ver los {PRODUCTOS.length} modelos <Icono nombre="flecha" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- BENTO: COLORES + CIFRAS + SALONES -->
  <section class="mx-auto max-w-7xl px-3 py-20 md:px-5 md:py-28">
    <div class="grid gap-3 md:grid-cols-6">
      <div class="reveal relative overflow-hidden rounded-[var(--radius-tarjeta)] bg-tinta p-7 text-white md:col-span-4 md:p-10">
        <div class="pointer-events-none absolute -right-32 -bottom-32 size-96 rounded-full bg-[radial-gradient(circle,rgba(201,168,101,0.3),transparent_65%)]"></div>
        <h2 class="titulo relative max-w-lg [&_em]:!text-oro">Cualquier modelo, <em>en tu color</em></h2>
        <div class="relative mt-8 space-y-5">
          {TELAS.map((t) => (
            <div>
              <p class="mb-3 text-sm text-white/70">{t.nombre}</p>
              <ul class="flex flex-wrap gap-2">
                {t.colores.map((c) => (
                  <li title={c.nombre} class="size-10 rounded-full ring-1 ring-white/20 md:size-11" style={`background:${c.hex}`}><span class="sr-only">{c.nombre}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <a href="/colores" class="btn relative mt-8 bg-oro text-tinta hover:bg-oro-claro">Ver telas y colores <Icono nombre="flecha" class="size-4" /></a>
      </div>

      <dl class="reveal grid grid-cols-2 gap-3 md:col-span-2">
        {CIFRAS.map((c) => (
          <div class="flex min-h-36 flex-col justify-between gap-4 rounded-[var(--radius-tarjeta)] bg-white p-5">
            <dt class="text-sm leading-snug text-humo">{c.etiqueta}</dt>
            <dd class="text-4xl font-semibold tracking-tight md:text-5xl">{c.valor}</dd>
          </div>
        ))}
      </dl>

      <a href="/estetica" class="reveal group relative overflow-hidden rounded-[var(--radius-tarjeta)] bg-white md:col-span-3">
        <Image src={mostrador.imagenes[0]} alt="Recepción con mostrador capitoné negro" widths={[480, 600]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[16/11] w-full object-cover transition-transform duration-700 ease-suave group-hover:scale-[1.03]" />
        <div class="flex items-end justify-between gap-4 p-6 md:p-8">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Equipá tu <em class="font-serif font-normal text-acento italic">salón</em></h2>
            <p class="mt-2 text-humo">Mostradores, camillas y sillones de espera en el color de tu marca.</p>
          </div>
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-tinta text-white transition group-hover:bg-acento"><Icono nombre="flecha" class="size-5" /></span>
        </div>
      </a>

      <a href="/como-comprar" class="reveal group relative overflow-hidden rounded-[var(--radius-tarjeta)] bg-acento-suave md:col-span-3">
        <Image src={camilla.imagenes[0]} alt="" widths={[480, 600]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[16/11] w-full object-cover transition-transform duration-700 ease-suave group-hover:scale-[1.03]" />
        <div class="flex items-end justify-between gap-4 p-6 md:p-8">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Cómo <em class="font-serif font-normal text-acento italic">comprar</em></h2>
            <p class="mt-2 text-humo">Elegís, te pasamos presupuesto por WhatsApp, lo fabricamos y te lo enviamos.</p>
          </div>
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-tinta text-white transition group-hover:bg-acento"><Icono nombre="flecha" class="size-5" /></span>
        </div>
      </a>
    </div>

    <div class="reveal mt-3 flex flex-col items-start justify-between gap-5 rounded-[var(--radius-tarjeta)] bg-white p-6 md:flex-row md:items-center md:px-10">
      <p class="text-xl font-medium tracking-tight md:text-2xl">¿Preferís comprar por Mercado Libre? <span class="text-humo">También estamos ahí.</span></p>
      <a href={SITIO.mercadolibre} target="_blank" rel="noopener" class="btn-ml shrink-0">Ver tienda en Mercado Libre</a>
    </div>
  </section>

  <Cta />
</Base>
