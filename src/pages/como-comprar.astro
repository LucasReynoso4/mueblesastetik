---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { SITIO } from '../data/sitio';

const PASOS = [
  { t: 'Elegí el modelo', d: 'Recorré el catálogo o mandanos una foto de lo que tenés en mente.' },
  { t: 'Elegí color y medida', d: 'Te asesoramos con la tela y el color, y adaptamos la medida a tu espacio.' },
  { t: 'Confirmás el presupuesto', d: 'Te pasamos precio y tiempo de fabricación por WhatsApp, sin compromiso.' },
  { t: 'Lo fabricamos y te lo enviamos', d: 'Lo hacemos en nuestro taller y lo enviamos a todo el país.' },
];

const PREGUNTAS = [
  { p: '¿Puedo pedir un mueble en un color que no está en la página?', r: 'Sí. Trabajamos con más de 30 colores en pana antimanchas y eco-cuero. Escribinos y te mandamos fotos de las telas disponibles.' },
  { p: '¿Hacen muebles a medida?', r: 'Sí, todos nuestros muebles se pueden adaptar. Pasanos las medidas de tu espacio y te decimos qué se puede hacer.' },
  { p: '¿Cuánto tarda la fabricación?', r: 'Depende del modelo y de la cantidad. Te confirmamos el tiempo exacto junto con el presupuesto.' },
  { p: '¿Hacen envíos?', r: 'Sí, enviamos a todo el país. El costo depende del destino y del tamaño del mueble.' },
  { p: '¿Cómo puedo pagar?', r: `Podés comprar a través de nuestra tienda en Mercado Libre, con todos sus medios de pago y su protección al comprador, o coordinar el pago directamente con nosotros por WhatsApp.` },
  { p: '¿Hacen equipamiento para locales y salones?', r: 'Sí, es una de nuestras especialidades: mostradores, camillas, sillones de espera y puffs en el color de tu marca.' },
];

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PREGUNTAS.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
<Base titulo="Cómo comprar" descripcion="Cómo pedir tu mueble a medida: elegís modelo, color y medida, te pasamos presupuesto y lo enviamos a todo el país." jsonLd={[faq]}>
  <section class="mx-auto max-w-7xl px-5 pt-12 pb-20 md:px-8 md:pt-20">
    <p class="antetitulo">Cómo comprar</p>
    <h1 class="titulo mt-4">Tu mueble, <em>en cuatro pasos</em></h1>
    <ol class="mt-14 grid gap-px overflow-hidden border border-linea bg-linea md:grid-cols-4">
      {PASOS.map((s, i) => (
        <li class="reveal bg-marfil p-8">
          <span class="font-serif text-5xl text-oro">{i + 1}</span>
          <p class="mt-5 font-serif text-xl">{s.t}</p>
          <p class="mt-2 text-sm leading-relaxed text-tinta/60">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="preguntas" class="scroll-mt-24 border-t border-linea bg-marfil">
    <div class="mx-auto max-w-3xl px-5 py-20 md:px-8">
      <h2 class="titulo !text-4xl">Preguntas <em>frecuentes</em></h2>
      <div class="mt-10 divide-y divide-linea border-y border-linea">
        {PREGUNTAS.map((q) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl [&::-webkit-details-marker]:hidden">
              {q.p}
              <span class="text-2xl text-oro transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 pr-10 leading-relaxed text-tinta/65">{q.r}</p>
          </details>
        ))}
      </div>
      <p class="mt-10 text-tinta/60">
        ¿Preferís comprar con la garantía de Mercado Libre? <a href={SITIO.mercadolibre} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-oro">Visitá nuestra tienda</a>.
      </p>
    </div>
  </section>
  <Cta />
</Base>
