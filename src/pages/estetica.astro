---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard.astro';
import Cta from '../components/Cta.astro';
import Icono from '../components/Icono.astro';
import hero from '../assets/hero.jpg';
import { PRODUCTOS } from '../data/productos';
import { linkWhatsApp } from '../data/sitio';

const RUBROS = ['Centros de estética', 'Pestañas y cejas', 'Uñas', 'Peluquerías', 'Spa y masajes', 'Locales de ropa', 'Consultorios', 'Showrooms'];

const AMBIENTES = [
  { titulo: 'Recepción', texto: 'Un mostrador capitoné en el color de tu marca es lo primero que ven tus clientas.', slugs: ['mostrador-capitone', 'mostrador-capitone-con-puffs', 'mostrador-curvo-capitone'] },
  { titulo: 'Sala de espera', texto: 'Sillones y puffs cómodos que además quedan perfectos en las fotos para redes.', slugs: ['sillon-labios', 'sillon-redondo-capitone', 'puff-redondo-capitone'] },
  { titulo: 'Gabinete', texto: 'Camillas ergonómicas y banquetas para trabajar cómoda todo el día.', slugs: ['camilla-capitone', 'puff-terciopelo'] },
];
const MENSAJE = '¡Hola! Tengo un salón y quiero equipar la recepción/sala de espera. ¿Me pasan opciones y precios?';
---
<Base titulo="Equipamiento para salones de estética" descripcion="Mostradores, camillas, sillones y puffs capitoné para centros de estética, peluquerías, uñas, pestañas y locales. En el color de tu marca.">
  <section class="mx-auto max-w-7xl px-3 pt-6 md:px-5 md:pt-10">
    <div class="relative overflow-hidden rounded-[var(--radius-tarjeta)] bg-tinta text-white">
      <Picture src={hero} alt="" formats={['avif', 'webp']} widths={[640, 1024]} sizes="100vw" class="zoom-entrada absolute inset-0 size-full object-cover opacity-45" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-tinta via-tinta/70 to-transparent"></div>
      <div class="relative px-6 py-20 md:px-14 md:py-32">
        <span class="etiqueta !bg-white/10 !text-white backdrop-blur">Para profesionales</span>
        <h1 class="titulo mt-6 max-w-3xl [&_em]:!text-oro">Equipá tu salón <em>con identidad propia</em></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
          Fabricamos mostradores, camillas, sillones y puffs en el color de tu marca, a la medida de tu local.
        </p>
        <a href={linkWhatsApp(MENSAJE)} target="_blank" rel="noopener" class="btn-wa mt-10"><Icono nombre="whatsapp" class="size-5" /> Cotizar mi salón</a>
      </div>
    </div>
  </section>

  <div class="mt-3 overflow-hidden border-y border-linea bg-nube py-4" aria-label="Rubros">
    <ul class="flex w-max animate-[desfile_35s_linear_infinite] gap-8 text-lg font-medium tracking-tight motion-reduce:animate-none">
      {[...RUBROS, ...RUBROS].map((r, i) => (
        <li class="flex items-center gap-8" aria-hidden={i >= RUBROS.length ? 'true' : undefined}>{r}<span class="text-oro" aria-hidden="true">✦</span></li>
      ))}
    </ul>
  </div>

  {AMBIENTES.map((a, i) => {
    const productos = a.slugs.map((s) => PRODUCTOS.find((p) => p.slug === s)).filter((p) => p !== undefined);
    return (
      <section class="mx-auto max-w-7xl px-3 pt-16 md:px-5 md:pt-24">
        <div class="reveal flex flex-col justify-between gap-4 px-2 md:flex-row md:items-end">
          <div class="flex items-center gap-4">
            <span class="grid size-14 place-items-center rounded-full bg-white text-lg font-semibold">0{i + 1}</span>
            <h2 class="titulo !text-4xl md:!text-6xl">{a.titulo}</h2>
          </div>
          <p class="max-w-md text-lg text-humo">{a.texto}</p>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-x-3 gap-y-8 md:gap-x-5 lg:grid-cols-3">
          {productos.map((p) => <div class="reveal"><ProductoCard producto={p} /></div>)}
        </div>
      </section>
    );
  })}

  <section class="mx-auto max-w-7xl px-3 py-16 md:px-5 md:py-24">
    <ul class="grid gap-3 md:grid-cols-3">
      {[
        { icono: 'tijera', t: 'El color de tu marca', d: 'Elegí entre más de 30 colores para que todo el local combine.' },
        { icono: 'regla', t: 'A la medida de tu local', d: 'Adaptamos el mostrador y los sillones al espacio que tenés.' },
        { icono: 'escudo', t: 'Telas resistentes', d: 'Eco-cuero fácil de limpiar para el uso de todos los días.' },
      ].map((b) => (
        <li class="reveal rounded-[var(--radius-tarjeta)] bg-white p-7">
          <span class="grid size-12 place-items-center rounded-full bg-acento-suave text-acento"><Icono nombre={b.icono as 'tijera'} class="size-6" /></span>
          <p class="mt-6 text-2xl font-semibold tracking-tight">{b.t}</p>
          <p class="mt-2 leading-relaxed text-humo">{b.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <Cta titulo="Contanos cómo es tu salón" enfasis="y te armamos una propuesta" texto="Mandanos fotos o medidas del espacio y el color de tu marca. Te respondemos con opciones y presupuesto." mensaje={MENSAJE} />
</Base>
