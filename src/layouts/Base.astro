---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import ListaConsulta from '../components/ListaConsulta.astro';
import { SITIO } from '../data/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  jsonLd?: Record<string, unknown>[];
}

const { titulo, descripcion = SITIO.descripcion, imagen = '/og.jpg', jsonLd = [] } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITIO.nombre}` : `${SITIO.nombre} · Muebles tapizados a medida`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const imagenAbs = new URL(imagen, Astro.site).href;

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: SITIO.nombre,
  url: SITIO.url,
  image: new URL('/og.jpg', Astro.site).href,
  logo: new URL('/icon-512.png', Astro.site).href,
  description: SITIO.descripcion,
  telephone: SITIO.whatsappVisible,
  address: { '@type': 'PostalAddress', addressRegion: 'Buenos Aires', addressCountry: 'AR' },
  areaServed: 'AR',
  sameAs: [SITIO.instagram, SITIO.mercadolibre],
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f0ea" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbs} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([negocio, ...jsonLd])} />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[999] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />
    <ListaConsulta />

    <script>
      const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Números que cuentan desde 0 (ej. "+1000")
      function contar(el: HTMLElement) {
        if (el.dataset.contado) return;
        el.dataset.contado = '1';
        const fin = Number(el.dataset.contar);
        const [antes, despues = ''] = (el.textContent ?? '').split(String(fin));
        const t0 = performance.now();
        const paso = (t: number) => {
          const k = Math.min((t - t0) / 1400, 1);
          el.textContent = `${antes}${Math.round(fin * (1 - Math.pow(1 - k, 3)))}${despues}`;
          if (k < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      }

      // Animaciones de entrada al hacer scroll
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('visible');
            if (!quieto) e.target.querySelectorAll<HTMLElement>('[data-contar]').forEach(contar);
            obs.unobserve(e.target);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal, .escalonado').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
