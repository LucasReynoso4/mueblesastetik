---
import Icono from './Icono.astro';
import { SITIO } from '../data/sitio';
---
<dialog
  id="lista-consulta"
  data-numero={SITIO.whatsapp}
  aria-labelledby="lista-titulo"
  class="m-0 ml-auto h-dvh max-h-dvh w-full max-w-md bg-crema p-0 text-tinta backdrop:bg-noche/60 backdrop:backdrop-blur-sm"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-linea px-6 py-5">
      <h2 id="lista-titulo" class="font-serif text-2xl">Tu lista de consulta</h2>
      <button type="button" data-cerrar-lista class="grid size-10 place-items-center rounded-full hover:bg-linea" aria-label="Cerrar">
        <Icono nombre="cerrar" />
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-4">
      <p data-lista-vacia class="py-10 text-center text-sm leading-relaxed text-tinta/60">
        Todavía no agregaste nada.<br />Sumá los muebles que te gustan con la tela y el color que quieras y mandanos todo junto por WhatsApp.
      </p>
      <ul data-lista-items class="divide-y divide-linea"></ul>
    </div>

    <div data-lista-acciones class="hidden border-t border-linea px-6 py-5">
      <a data-lista-enviar href="#" target="_blank" rel="noopener" class="btn-wa w-full">
        <Icono nombre="whatsapp" class="size-4" /> Enviar consulta por WhatsApp
      </a>
      <button type="button" data-lista-vaciar class="mt-3 w-full py-2 text-xs uppercase tracking-[0.2em] text-tinta/50 hover:text-tinta">Vaciar lista</button>
    </div>
  </div>
</dialog>

<div data-aviso-lista role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-24 z-50 flex justify-center px-4 opacity-0 transition-opacity duration-300">
  <p class="flex items-center gap-2 bg-noche px-5 py-3 text-sm text-crema shadow-lg"><Icono nombre="check" class="size-4 text-oro" /> <span data-aviso-texto>Agregado a tu lista</span></p>
</div>

<script>
  import { alCambiarLista, quitarDeLista, vaciarLista, mensajeLista, agregarALista } from '../scripts/lista';

  const dialogo = document.getElementById('lista-consulta') as HTMLDialogElement;
  const ul = dialogo.querySelector<HTMLUListElement>('[data-lista-items]')!;
  const vacia = dialogo.querySelector<HTMLElement>('[data-lista-vacia]')!;
  const acciones = dialogo.querySelector<HTMLElement>('[data-lista-acciones]')!;
  const enviar = dialogo.querySelector<HTMLAnchorElement>('[data-lista-enviar]')!;
  const aviso = document.querySelector<HTMLElement>('[data-aviso-lista]')!;
  const numero = dialogo.dataset.numero;

  alCambiarLista((items) => {
    document.querySelectorAll<HTMLElement>('[data-contador-lista]').forEach((c) => {
      c.textContent = String(items.length);
      c.classList.toggle('hidden', items.length === 0);
    });
    vacia.hidden = items.length > 0;
    acciones.classList.toggle('hidden', items.length === 0);
    ul.replaceChildren(
      ...items.map((item, i) => {
        const li = document.createElement('li');
        li.className = 'flex items-start justify-between gap-4 py-4';
        const texto = document.createElement('div');
        const nombre = document.createElement('a');
        nombre.href = `/productos/${item.slug}`;
        nombre.className = 'font-serif text-lg hover:underline';
        nombre.textContent = item.nombre;
        texto.append(nombre);
        if (item.color) {
          const color = document.createElement('p');
          color.className = 'mt-0.5 text-xs uppercase tracking-[0.15em] text-tinta/55';
          color.textContent = item.color;
          texto.append(color);
        }
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'shrink-0 text-xs text-tinta/50 underline hover:text-tinta';
        quitar.textContent = 'Quitar';
        quitar.addEventListener('click', () => quitarDeLista(i));
        li.append(texto, quitar);
        return li;
      }),
    );
    enviar.href = `https://wa.me/${numero}?text=${encodeURIComponent(mensajeLista(items))}`;
  });

  document.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    if (objetivo.closest('[data-abrir-lista]')) dialogo.showModal();
    if (objetivo.closest('[data-cerrar-lista]')) dialogo.close();

    const boton = objetivo.closest<HTMLElement>('[data-agregar]');
    if (boton) {
      const { slug = '', nombre = '', color } = boton.dataset;
      agregarALista({ slug, nombre, color: color || undefined });
      const texto = aviso.querySelector('[data-aviso-texto]')!;
      texto.textContent = `${nombre}${color ? ` (${color})` : ''} agregado a tu lista`;
      aviso.style.opacity = '1';
      window.setTimeout(() => (aviso.style.opacity = '0'), 2200);
    }
  });

  // Cerrar tocando afuera del panel
  dialogo.addEventListener('click', (e) => {
    if (e.target === dialogo) dialogo.close();
  });
  dialogo.querySelector('[data-lista-vaciar]')!.addEventListener('click', vaciarLista);
</script>

<style>
  dialog[open] {
    animation: entrar 0.35s var(--ease-suave);
  }
  @keyframes entrar {
    from { transform: translateX(100%); }
  }
</style>
