---
import Icono from './Icono.astro';
import { SITIO, linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';
import { CATEGORIAS } from '../data/productos';
const anio = new Date().getFullYear();
---
<footer class="bg-noche text-crema/70">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-8">
    <div>
      <p class="font-serif text-2xl text-crema">Muebles Astetik</p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Muebles tapizados a medida, fabricados por nosotros. Envíos a todo el país.
      </p>
    </div>
    <div>
      <p class="mb-4 text-[11px] uppercase tracking-[0.25em] text-oro">Productos</p>
      <ul class="space-y-2.5 text-sm">
        {CATEGORIAS.map((c) => <li><a class="hover:text-crema" href={`/catalogo?categoria=${c.id}`}>{c.nombre}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-4 text-[11px] uppercase tracking-[0.25em] text-oro">Información</p>
      <ul class="space-y-2.5 text-sm">
        <li><a class="hover:text-crema" href="/estetica">Equipamiento para salones</a></li>
        <li><a class="hover:text-crema" href="/colores">Colores y telas</a></li>
        <li><a class="hover:text-crema" href="/como-comprar">Cómo comprar</a></li>
        <li><a class="hover:text-crema" href="/como-comprar#preguntas">Preguntas frecuentes</a></li>
      </ul>
    </div>
    <div>
      <p class="mb-4 text-[11px] uppercase tracking-[0.25em] text-oro">Contacto</p>
      <ul class="space-y-3 text-sm">
        <li><a class="flex items-center gap-2.5 hover:text-crema" href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener"><Icono nombre="whatsapp" class="size-4" /> {SITIO.whatsappVisible}</a></li>
        <li><a class="flex items-center gap-2.5 hover:text-crema" href={SITIO.instagram} target="_blank" rel="noopener"><Icono nombre="instagram" class="size-4" /> {SITIO.instagramUsuario}</a></li>
        <li><a class="flex items-center gap-2.5 hover:text-crema" href={SITIO.mercadolibre} target="_blank" rel="noopener"><span class="grid size-4 place-items-center rounded-full bg-ml text-[8px] font-bold text-[#2d3277]">ML</span> Tienda en Mercado Libre</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-oro/10">
    <p class="mx-auto max-w-7xl px-5 py-6 text-xs text-crema/40 md:px-8">© {anio} Muebles Astetik · {SITIO.ubicacion}</p>
  </div>
</footer>
