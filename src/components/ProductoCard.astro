---
import { Picture } from 'astro:assets';
import type { Producto } from '../data/productos';
import { formatoPrecio, nombreCategoria, precioDesde } from '../data/productos';

interface Props {
  producto: Producto;
  prioridad?: boolean;
}
const { producto: p, prioridad = false } = Astro.props;
---
<article
  class="group relative"
  data-producto
  data-categoria={p.categoria}
  data-usos={p.usos.join(' ')}
>
  <div class="relative aspect-[4/5] overflow-hidden bg-linea">
    <Picture
      src={p.fotos[0].imagen}
      alt={p.nombre}
      formats={['avif', 'webp']} fallbackFormat="webp"
      widths={[320, 480, 600]}
      sizes="(min-width: 1024px) 33vw, 50vw"
      loading={prioridad ? 'eager' : 'lazy'}
      class="size-full object-cover transition-transform duration-[1.2s] ease-suave group-hover:scale-105"
    />
  </div>
  <div class="pt-4">
    <p class="text-[10px] uppercase tracking-[0.25em] text-oro">{nombreCategoria(p.categoria)}</p>
    <h3 class="mt-1 font-serif text-lg leading-snug sm:text-xl">
      <a href={`/productos/${p.slug}`} class="after:absolute after:inset-0">{p.nombre}</a>
    </h3>
    <p class="mt-1.5 hidden text-sm leading-relaxed text-tinta/60 sm:block">{p.resumen}</p>
    <p class="mt-2 text-sm text-tinta/80">
      {p.opciones.length > 1 && <span class="text-tinta/50">Desde </span>}{formatoPrecio(precioDesde(p))}
      {p.opciones.length > 1 && <span class="text-tinta/50"> · {p.opciones.length} {(p.etiquetaOpcion ?? 'opción').toLowerCase() === 'medida' ? 'medidas' : 'opciones'}</span>}
    </p>
  </div>
</article>
