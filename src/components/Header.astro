---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import Icono from './Icono.astro';
import { linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';

const LINKS = [
  { href: '/catalogo', texto: 'Catálogo' },
  { href: '/estetica', texto: 'Para tu salón' },
  { href: '/colores', texto: 'Telas y colores' },
  { href: '/como-comprar', texto: 'Cómo comprar' },
];
const actual = Astro.url.pathname.replace(/\.html$/, '');
---
<header id="header" class="sticky top-0 z-50 bg-tinta text-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-3 md:px-5">
    <a href="/" class="flex items-center gap-3" aria-label="Muebles Astetik, inicio">
      <Image src={logo} alt="" width={44} height={44} class="size-11 rounded-full object-cover ring-1 ring-oro/40" loading="eager" />
      <span class="flex flex-col leading-none">
        <span class="text-[10px] font-semibold tracking-[0.32em] text-oro">MUEBLES</span>
        <span class="mt-1 font-serif text-[22px] italic">Astetik</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {LINKS.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={actual === l.href ? 'page' : undefined}
              class="relative px-4 py-2 text-[15px] text-white/70 transition hover:text-white aria-[current=page]:text-oro after:absolute after:inset-x-4 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-oro after:transition aria-[current=page]:after:scale-x-100 hover:after:scale-x-100"
            >{l.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-abrir-lista
        class="relative grid size-11 place-items-center rounded-full transition hover:bg-white/10"
        aria-label="Ver mi lista de consulta"
      >
        <Icono nombre="lista" class="size-[22px]" />
        <span data-contador-lista class="absolute top-1 right-1 hidden min-w-5 rounded-full bg-oro px-1 text-center text-[11px] leading-5 font-semibold text-tinta">0</span>
      </button>
      <a href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener" class="btn-wa ml-1 hidden md:inline-flex">
        <Icono nombre="whatsapp" class="size-4" /> Consultar
      </a>
      <button type="button" data-menu-boton aria-expanded="false" aria-controls="menu-movil" class="grid size-11 place-items-center rounded-full hover:bg-white/10 lg:hidden" aria-label="Abrir menú">
        <Icono nombre="menu" class="size-6" />
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Menú" hidden class="border-t border-white/10 bg-tinta px-3 pb-4 lg:hidden">
    <ul>
      {LINKS.map((l) => (
        <li>
          <a href={l.href} class="flex items-center justify-between rounded-2xl px-4 py-4 text-2xl font-semibold tracking-tight hover:bg-white/10">
            {l.texto} <Icono nombre="flecha" class="size-5 text-oro" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
  const menu = document.getElementById('menu-movil')!;
  boton.addEventListener('click', () => {
    const abrir = menu.hidden;
    menu.hidden = !abrir;
    boton.setAttribute('aria-expanded', String(abrir));
  });
</script>
