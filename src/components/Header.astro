---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import Icono from './Icono.astro';
import { linkWhatsApp, MENSAJE_GENERAL } from '../data/sitio';

const LINKS = [
  { href: '/catalogo', texto: 'Catálogo' },
  { href: '/estetica', texto: 'Para tu salón' },
  { href: '/colores', texto: 'Telas y colores' },
  { href: '/como-comprar', texto: 'Cómo comprar' },
];
const actual = Astro.url.pathname.replace(/\.html$/, '');
---
<header id="header" class="sticky top-0 z-50 px-3 pt-3 md:px-5">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 rounded-full bg-white/85 pr-2 pl-2 shadow-[0_1px_0_rgba(21,19,18,0.06),0_8px_24px_-12px_rgba(21,19,18,0.15)] ring-1 ring-linea/70 backdrop-blur-xl">
    <a href="/" class="flex items-center gap-2.5 rounded-full pr-3" aria-label="Muebles Astetik, inicio">
      <Image src={logo} alt="" width={48} height={48} class="size-12 rounded-full object-cover" loading="eager" />
      <span class="text-[17px] font-semibold tracking-tight">Astetik</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {LINKS.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={actual === l.href ? 'page' : undefined}
              class="rounded-full px-4 py-2 text-[15px] text-humo transition hover:bg-papel hover:text-tinta aria-[current=page]:bg-tinta aria-[current=page]:text-white"
            >{l.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-abrir-lista
        class="relative grid size-12 place-items-center rounded-full transition hover:bg-papel"
        aria-label="Ver mi lista de consulta"
      >
        <Icono nombre="lista" class="size-[22px]" />
        <span data-contador-lista class="absolute top-1.5 right-1.5 hidden min-w-5 rounded-full bg-oro px-1 text-center text-[11px] leading-5 font-semibold text-tinta">0</span>
      </button>
      <a href={linkWhatsApp(MENSAJE_GENERAL)} target="_blank" rel="noopener" class="btn-wa hidden md:inline-flex">
        <Icono nombre="whatsapp" class="size-4" /> Consultar
      </a>
      <button type="button" data-menu-boton aria-expanded="false" aria-controls="menu-movil" class="grid size-12 place-items-center rounded-full hover:bg-papel lg:hidden" aria-label="Abrir menú">
        <Icono nombre="menu" class="size-6" />
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Menú" hidden class="mx-auto mt-2 max-w-7xl rounded-[var(--radius-tarjeta)] bg-white p-3 shadow-xl ring-1 ring-linea lg:hidden">
    <ul>
      {LINKS.map((l) => (
        <li>
          <a href={l.href} class="flex items-center justify-between rounded-2xl px-4 py-4 text-2xl font-semibold tracking-tight hover:bg-papel">
            {l.texto} <Icono nombre="flecha" class="size-5 text-humo" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
  const menu = document.getElementById('menu-movil')!;
  boton.addEventListener('click', () => {
    const abrir = menu.hidden;
    menu.hidden = !abrir;
    boton.setAttribute('aria-expanded', String(abrir));
  });
</script>
